{
  "name": "@rakazo/desktop",
  "productName": "Rakazo",
  "version": "0.7.0",
  "description": "Rakazo lightweight native macOS Electron client with native notifications and Chromium engine",
  "author": {
    "name": "Rakazo"
  },
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "bundle/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "node scripts/build.mjs",
    "pack:mac": "pnpm build && electron-builder --mac --x64 --arm64 --dir",
    "pack:mac:x64": "pnpm build && electron-builder --mac --x64 --dir",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/tests"
  },
  "devDependencies": {
    "electron": "42.11.16",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "dev.rakazo.mac",
    "productName": "Rakazo",
    "directories": {
      "output": "release"
    },
    "files": [
      "bundle/**/*",
      "frontend/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon-macos.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
